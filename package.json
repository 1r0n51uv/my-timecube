{
  "name": "my-timecube",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.18.1",
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"pnpm run dev:frontend\" \"pnpm run dev:backend\"",
    "dev:frontend": "pnpm -C apps/frontend dev",
    "dev:backend": "pnpm -C apps/backend dev",
    "build": "pnpm -C apps/backend build && pnpm -C apps/frontend build",
    "lint": "pnpm -C apps/frontend lint && pnpm -C apps/backend lint",
    "test": "pnpm -C apps/frontend test",
    "prisma:generate": "pnpm -C apps/backend prisma:generate",
    "prisma:push": "pnpm -C apps/backend prisma:push",
    "prisma:seed": "pnpm -C apps/backend prisma:seed",
    "generate:client": "pnpm -C apps/frontend generate:client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
